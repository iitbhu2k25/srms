# Copy to .env to override the defaults used by docker-compose.yml
POSTGRES_DB=srms
POSTGRES_USER=srms
POSTGRES_PASSWORD=srms
WEB_PORT=3010
API_PORT=8010
DB_PORT=5433
SIMULATE_LIVE=true

# Cloudflare Tunnel "srms" (Zero Trust -> Networks -> Tunnels -> srms -> token).
# Public hostname: srms-api.slcrdss.in -> http://fast_backend:8000
CLOUDFLARE_TUNNEL_TOKEN=
